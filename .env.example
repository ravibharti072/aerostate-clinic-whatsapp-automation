# ========================================================
# Aerostate Clinic WhatsApp Automation - Environment Config
# ========================================================

# 1. Meta WhatsApp Cloud API credentials
# Obtain these from https://developers.facebook.com -> Your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=YOUR_TEMPORARY_OR_PERMANENT_ACCESS_TOKEN
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
VERIFY_TOKEN=aerostate_secret_verify_token_2026
META_GRAPH_VERSION=v21.0
# App Secret from Meta App Dashboard -> App Settings -> Basic (enables HMAC SHA-256 webhook verification)
META_APP_SECRET=

# 2. Security & Authentication
# Generate a strong 64-char key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# 3. Database
# Default is local SQLite (safe & zero-config). For PostgreSQL: postgresql://user:password@localhost:5432/clinic_db
DATABASE_URL=sqlite:///./clinic.db

# 4. Optional Google Gemini AI API Key for Natural Language Booking
# Get free key from https://aistudio.google.com
GEMINI_API_KEY=

# 5. Clinic Profile & Healthcare Registry
CLINIC_NAME=Aerostate Speciality Clinic
CLINIC_TAGLINE=Medical Center & OPD Consultation Services
CLINIC_REG_NO=UP-AGR-2026-MED
CLINIC_ADDRESS=Plot 14, Fatehabad Road, Tajganj, Agra (U.P.) - 282001
CLINIC_PHONE=+91 98765 43210
CLINIC_EMAIL=contact@aerostateclinic.com
CLINIC_HOURS=Mon - Sat: 09:00 AM - 08:00 PM

# 6. Clinical Policies & Operational Standards
OPD_SLOT_DURATION=15
CHECKIN_GRACE_PERIOD=15
EMERGENCY_TAT=30
LAB_TAT_STANDARD=24
FOLLOWUP_DAYS=7
