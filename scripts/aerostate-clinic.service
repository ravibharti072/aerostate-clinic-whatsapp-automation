[Unit]
Description=Aerostate Clinic WhatsApp Automation Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/aerostate-clinic-whatsapp-automation
EnvironmentFile=/var/www/aerostate-clinic-whatsapp-automation/.env
ExecStart=/var/www/aerostate-clinic-whatsapp-automation/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=append:/var/log/aerostate_backend.log
StandardError=append:/var/log/aerostate_error.log

[Install]
WantedBy=multi-user.target
